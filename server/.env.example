PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of allowed frontend origins in production.
# Leave unset in local dev to allow any origin. The first URL in this list
# is also where users get redirected back to after Google OAuth.
FRONTEND_URL=http://localhost:5173

# Where THIS backend is publicly reachable — used to build the Google OAuth
# redirect URI. Must exactly match an "Authorized redirect URI" on your
# Google OAuth client (see README).
BACKEND_URL=http://localhost:4000

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
# Required for both "Sign in with Google" and the Calendar/Gmail connection.
GOOGLE_CLIENT_ID=
# The Client Secret for that same OAuth client. Needed for the Calendar/Gmail
# OAuth code flow (not needed for basic Sign-In). Keep this out of git.
GOOGLE_CLIENT_SECRET=
