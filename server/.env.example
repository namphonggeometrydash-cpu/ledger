PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated list of allowed frontend origins in production.
# Leave unset in local dev to allow any origin.
FRONTEND_URL=
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
# Required only if you want the "Sign in with Google" button to work.
GOOGLE_CLIENT_ID=
